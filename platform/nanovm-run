#!/bin/bash
# Run registered agents inside the nanovm guest (or locally with NANOVM_ROOT set).
set -euo pipefail

NANOVM_ROOT="${NANOVM_ROOT:-/opt/nanovm}"
AGENTS_DIR="${NANOVM_ROOT}/agents"

if [[ "$NANOVM_ROOT" == /opt/nanovm ]]; then
  GLOBAL_ENV="${NANOVM_ENV_FILE:-/etc/nanovm/agent.env}"
  AGENT_ENV_DIR="${NANOVM_AGENT_ENV_DIR:-/etc/nanovm/agents}"
  LOG_DIR="${NANOVM_LOG_DIR:-/var/log/nanovm}"
  STATE_DIR="${NANOVM_STATE_DIR:-/var/run/nanovm}"
else
  GLOBAL_ENV="${NANOVM_ENV_FILE:-${NANOVM_ROOT}/.env}"
  AGENT_ENV_DIR="${NANOVM_AGENT_ENV_DIR:-${NANOVM_ROOT}/.nanovm/agents}"
  LOG_DIR="${NANOVM_LOG_DIR:-${NANOVM_ROOT}/.nanovm/logs}"
  STATE_DIR="${NANOVM_STATE_DIR:-${NANOVM_ROOT}/.nanovm/run}"
fi

RUN_USER="${NANOVM_RUN_USER:-alpine}"

manifest_field() {
  local file=$1 key=$2
  # BSD sed (macOS) does not treat \s as whitespace; use [[:space:]].
  grep -E "^${key}:" "$file" 2>/dev/null | head -1 \
    | sed -E 's/^[^:]+:[[:space:]]*//' \
    | sed -E 's/[[:space:]]+$//' \
    | tr -d '"'"'"
}

manifest_env_keys() {
  local file=$1
  awk '/^env:/{e=1;next} e && /^  - /{print $2} e && /^[^ ]/ && !/^  -/{e=0}' "$file"
}

manifest_has_cursor() {
  grep -qE '^cursor:' "$1"
}

cursor_model_from_manifest() {
  awk '/^cursor:/{c=1;next} c && /^  model:/{print $2; exit} c && /^[^ ]/ && !/^ /{c=0}' "$1"
}

write_agent_env_kv() {
  local id=$1 key=$2
  local f="${AGENT_ENV_DIR}/${id}.env"
  mkdir -p "$AGENT_ENV_DIR"
  python3 - "$f" "$key" <<'PY'
import os
import sys

path, key = sys.argv[1], sys.argv[2]
val = os.environ.get(key, "")
lines: list[str] = []
if os.path.isfile(path):
    with open(path, encoding="utf-8") as fp:
        for line in fp:
            if not line.startswith(key + "="):
                lines.append(line.rstrip("\n"))
lines.append(f"{key}={val}")
with open(path, "w", encoding="utf-8") as fp:
    fp.write("\n".join(lines) + "\n")
os.chmod(path, 0o600)
PY
}

ensure_cursor_api_key() {
  local id=$1 mf=$2
  manifest_has_cursor "$mf" || return 0
  export CURSOR_MODEL="${CURSOR_MODEL:-$(cursor_model_from_manifest "$mf")}"
  export CURSOR_MODEL="${CURSOR_MODEL:-composer-2.5}"
  if [[ -n "${CURSOR_API_KEY:-}" ]]; then
    return 0
  fi
  if [[ ! -t 0 ]]; then
    echo "CURSOR_API_KEY is not set on this VM." >&2
    echo "From the VM shell: nanovm-run run ${id}" >&2
    echo "Or from your Mac: make vm-news  (SSH with TTY to this guest)" >&2
    echo "Or create ${AGENT_ENV_DIR}/${id}.env with CURSOR_API_KEY=..." >&2
    return 1
  fi
  echo ""
  echo "=== Cursor API key (Composer ${CURSOR_MODEL}) ==="
  echo "Create one: https://cursor.com/dashboard/integrations"
  read -rsp "CURSOR_API_KEY: " CURSOR_API_KEY
  echo ""
  if [[ -z "${CURSOR_API_KEY}" ]]; then
    echo "empty key; aborting" >&2
    return 1
  fi
  export CURSOR_API_KEY
  write_agent_env_kv "$id" CURSOR_API_KEY
}

load_env_for_agent() {
  local id=$1
  if [[ -f "$GLOBAL_ENV" ]]; then
    set -a
    # shellcheck disable=SC1090
    source "$GLOBAL_ENV"
    set +a
  fi
  local per_agent="${AGENT_ENV_DIR}/${id}.env"
  if [[ -f "$per_agent" ]]; then
    set -a
    # shellcheck disable=SC1090
    source "$per_agent"
    set +a
  fi
}

check_required_env() {
  local file=$1
  local missing=0
  while read -r key; do
    [[ -z "$key" ]] && continue
    if [[ -z "${!key:-}" ]]; then
      echo "missing env: $key (set in ${GLOBAL_ENV} or ${AGENT_ENV_DIR}/<id>.env)" >&2
      missing=1
    fi
  done < <(manifest_env_keys "$file")
  return "$missing"
}

agent_dir() {
  local id=$1
  local dir="${AGENTS_DIR}/${id}"
  if [[ ! -f "${dir}/manifest.yaml" ]]; then
    echo "unknown agent: ${id}" >&2
    return 1
  fi
  printf '%s\n' "$dir"
}

cmd_list() {
  echo "Agents under ${AGENTS_DIR}:"
  for mf in "${AGENTS_DIR}"/*/manifest.yaml; do
    [[ -f "$mf" ]] || continue
    id=$(manifest_field "$mf" id)
    desc=$(manifest_field "$mf" description)
    mode=$(manifest_field "$mf" mode)
    printf '  %-12s %-6s %s\n' "$id" "$mode" "$desc"
  done
}

run_agent() {
  local id=$1
  shift || true
  local dir
  dir=$(agent_dir "$id") || exit 1
  local mf="${dir}/manifest.yaml"
  local entry runtime mode
  entry=$(manifest_field "$mf" entry)
  runtime=$(manifest_field "$mf" runtime)
  mode=$(manifest_field "$mf" mode)

  load_env_for_agent "$id"
  ensure_cursor_api_key "$id" "$mf" || exit 1
  check_required_env "$mf" || exit 1

  local entry_path="${dir}/${entry}"
  if [[ ! -x "$entry_path" ]] && [[ ! -f "$entry_path" ]]; then
    echo "entry not found: ${entry_path}" >&2
    exit 1
  fi
  chmod +x "$entry_path" 2>/dev/null || true

  run_once_body() {
    cd "$dir"
    if [[ -d "${NANOVM_ROOT}/venv/bin" ]]; then
      export PATH="${NANOVM_ROOT}/venv/bin:${PATH}"
    fi
    case "$runtime" in
      bash) bash "$entry" "$@" ;;
      python3) python3 "$entry" "$@" ;;
      *) "$entry_path" "$@" ;;
    esac
  }

  case "$mode" in
    once)
      mkdir -p "$LOG_DIR"
      local log="${LOG_DIR}/${id}.log"
      local out rc
      out=$(mktemp -t "nanovm-${id}.XXXXXX")
      set +e
      run_once_body "$@" >"$out" 2>&1
      rc=$?
      set -e
      {
        echo "=== $(date -u +'%Y-%m-%dT%H:%M:%SZ') nanovm-run run ${id} ==="
        cat "$out"
        echo "=== exit ${rc} @ $(date -u +'%Y-%m-%dT%H:%M:%SZ') ==="
      } | tee -a "$log"
      rm -f "$out"
      exit "$rc"
      ;;
    daemon)
      mkdir -p "$LOG_DIR" "$STATE_DIR"
      local log="${LOG_DIR}/${id}.log"
      local pidfile="${STATE_DIR}/${id}.pid"
      if [[ -f "$pidfile" ]] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then
        echo "agent ${id} already running (pid $(cat "$pidfile"))"
        exit 0
      fi
      nohup "$0" _exec "$id" "$@" >>"$log" 2>&1 &
      echo $! >"$pidfile"
      echo "started agent ${id} (pid $(cat "$pidfile")), log ${log}"
      ;;
    *)
      echo "unknown mode in manifest: ${mode}" >&2
      exit 1
      ;;
  esac
}

cmd_stop() {
  local id=$1
  local pidfile="${STATE_DIR}/${id}.pid"
  if [[ ! -f "$pidfile" ]]; then
    echo "agent ${id} not running"
    return 0
  fi
  kill "$(cat "$pidfile")" 2>/dev/null || true
  rm -f "$pidfile"
  echo "stopped agent ${id}"
}

usage() {
  cat <<EOF
Usage: nanovm-run list
       nanovm-run run <agent-id> [args...]
       nanovm-run daemon <agent-id> [args...]
       nanovm-run stop <agent-id>
EOF
}

main() {
  local cmd=${1:-}
  shift || true
  case "$cmd" in
    list) cmd_list ;;
    run) run_agent "$@" ;;
    daemon) run_agent "$@" ;;
    stop) cmd_stop "$@" ;;
    _exec)
      local id=$1
      shift
      local dir
      dir=$(agent_dir "$id") || exit 1
      local mf="${dir}/manifest.yaml"
      local entry runtime
      entry=$(manifest_field "$mf" entry)
      runtime=$(manifest_field "$mf" runtime)
      load_env_for_agent "$id"
      ensure_cursor_api_key "$id" "$mf" || exit 1
      cd "$dir"
      case "$runtime" in
        bash) exec bash "$entry" "$@" ;;
        python3) exec python3 "$entry" "$@" ;;
        *) exec "./${entry}" "$@" ;;
      esac
      ;;
    ""|-h|--help|help) usage ;;
    *)
      echo "unknown command: $cmd" >&2
      usage
      exit 1
      ;;
  esac
}

main "$@"
