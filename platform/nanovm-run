#!/bin/bash
# Run registered agents inside the nanovm guest (or locally with NANOVM_ROOT set).
set -euo pipefail

NANOVM_ROOT="${NANOVM_ROOT:-/opt/nanovm}"
AGENTS_DIR="${NANOVM_ROOT}/agents"
GLOBAL_ENV="${NANOVM_ENV_FILE:-/etc/nanovm/agent.env}"
LOG_DIR="${NANOVM_LOG_DIR:-/var/log/nanovm}"
RUN_USER="${NANOVM_RUN_USER:-alpine}"

manifest_field() {
  local file=$1 key=$2
  grep -E "^${key}:" "$file" 2>/dev/null | head -1 | sed -E 's/^[^:]+:\s*//' | tr -d '"'"'"
}

manifest_env_keys() {
  local file=$1
  awk '/^env:/{e=1;next} e && /^  - /{print $2} e && /^[^ ]/ && !/^  -/{e=0}' "$file"
}

load_env_for_agent() {
  local id=$1
  if [[ -f "$GLOBAL_ENV" ]]; then
    set -a
    # shellcheck disable=SC1090
    source "$GLOBAL_ENV"
    set +a
  fi
  local per_agent="/etc/nanovm/agents/${id}.env"
  if [[ -f "$per_agent" ]]; then
    set -a
    # shellcheck disable=SC1090
    source "$per_agent"
    set +a
  fi
}

check_required_env() {
  local file=$1
  local missing=0
  while read -r key; do
    [[ -z "$key" ]] && continue
    if [[ -z "${!key:-}" ]]; then
      echo "missing env: $key (set in ${GLOBAL_ENV} or /etc/nanovm/agents/<id>.env)" >&2
      missing=1
    fi
  done < <(manifest_env_keys "$file")
  return "$missing"
}

agent_dir() {
  local id=$1
  local dir="${AGENTS_DIR}/${id}"
  if [[ ! -f "${dir}/manifest.yaml" ]]; then
    echo "unknown agent: ${id}" >&2
    return 1
  fi
  printf '%s\n' "$dir"
}

cmd_list() {
  echo "Agents under ${AGENTS_DIR}:"
  for mf in "${AGENTS_DIR}"/*/manifest.yaml; do
    [[ -f "$mf" ]] || continue
    id=$(manifest_field "$mf" id)
    desc=$(manifest_field "$mf" description)
    mode=$(manifest_field "$mf" mode)
    printf '  %-12s %-6s %s\n' "$id" "$mode" "$desc"
  done
}

run_agent() {
  local id=$1
  shift || true
  local dir
  dir=$(agent_dir "$id") || exit 1
  local mf="${dir}/manifest.yaml"
  local entry runtime mode
  entry=$(manifest_field "$mf" entry)
  runtime=$(manifest_field "$mf" runtime)
  mode=$(manifest_field "$mf" mode)

  load_env_for_agent "$id"
  check_required_env "$mf" || exit 1

  local entry_path="${dir}/${entry}"
  if [[ ! -x "$entry_path" ]] && [[ ! -f "$entry_path" ]]; then
    echo "entry not found: ${entry_path}" >&2
    exit 1
  fi
  chmod +x "$entry_path" 2>/dev/null || true

  mkdir -p "$LOG_DIR"
  local log="${LOG_DIR}/${id}.log"

  run_once() {
    cd "$dir"
    case "$runtime" in
      bash) exec bash "$entry" "$@" ;;
      python3) exec python3 "$entry" "$@" ;;
      *) exec "$entry_path" "$@" ;;
    esac
  }

  case "$mode" in
    once)
      run_once "$@"
      ;;
    daemon)
      mkdir -p /var/run/nanovm
      if [[ -f "/var/run/nanovm/${id}.pid" ]] && kill -0 "$(cat "/var/run/nanovm/${id}.pid")" 2>/dev/null; then
        echo "agent ${id} already running (pid $(cat "/var/run/nanovm/${id}.pid"))"
        exit 0
      fi
      nohup "$0" _exec "$id" "$@" >>"$log" 2>&1 &
      echo $! >"/var/run/nanovm/${id}.pid"
      echo "started agent ${id} (pid $(cat /var/run/nanovm/${id}.pid)), log ${log}"
      ;;
    *)
      echo "unknown mode in manifest: ${mode}" >&2
      exit 1
      ;;
  esac
}

cmd_stop() {
  local id=$1
  local pidfile="/var/run/nanovm/${id}.pid"
  if [[ ! -f "$pidfile" ]]; then
    echo "agent ${id} not running"
    return 0
  fi
  kill "$(cat "$pidfile")" 2>/dev/null || true
  rm -f "$pidfile"
  echo "stopped agent ${id}"
}

usage() {
  cat <<EOF
Usage: nanovm-run list
       nanovm-run run <agent-id> [args...]
       nanovm-run daemon <agent-id> [args...]
       nanovm-run stop <agent-id>
EOF
}

main() {
  local cmd=${1:-}
  shift || true
  case "$cmd" in
    list) cmd_list ;;
    run) run_agent "$@" ;;
    daemon) run_agent "$@" ;;
    stop) cmd_stop "$@" ;;
    _exec)
      local id=$1
      shift
      local dir
      dir=$(agent_dir "$id") || exit 1
      local mf="${dir}/manifest.yaml"
      local entry runtime
      entry=$(manifest_field "$mf" entry)
      runtime=$(manifest_field "$mf" runtime)
      load_env_for_agent "$id"
      cd "$dir"
      case "$runtime" in
        bash) exec bash "$entry" "$@" ;;
        python3) exec python3 "$entry" "$@" ;;
        *) exec "./${entry}" "$@" ;;
      esac
      ;;
    ""|-h|--help|help) usage ;;
    *)
      echo "unknown command: $cmd" >&2
      usage
      exit 1
      ;;
  esac
}

main "$@"
